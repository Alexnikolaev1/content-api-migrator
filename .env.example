# Copy values into your shell (this project does not auto-load .env).

# Option A — short-lived OAuth access token:
#   $env:MERCHANT_ACCESS_TOKEN = "ya29...."

# Option B — service account / ADC:
#   $env:GOOGLE_APPLICATION_CREDENTIALS = "C:\path\to\service-account.json"
# Scope used: https://www.googleapis.com/auth/content

# Pass Merchant Center IDs as CLI flags (required):
#   --account-id 123456789
#   --data-source accounts/123456789/dataSources/987654321
